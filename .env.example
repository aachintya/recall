# Copy to .env. Never prefix secrets with VITE_ (those are public).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional; default 3000.
PORT=3000
# One deadline covers the complete provider request, including its body.
# Values above 45000 are capped so the browser can receive the server error.
LLM_TIMEOUT_MS=45000
